{
  "command": [
    "node",
    "--test",
    "--test-reporter=tap"
  ],
  "defences": {
    "Tokens: the client keeps the router's usage": {
      "file": "src/llm.js",
      "live": "backend: parsed.backend, usage: parsed.usage ?? null });",
      "dead": "backend: parsed.backend, usage: null });",
      "expect": [
        "the answer carries the tokens the router reported, null when it reports none"
      ]
    },
    "Tokens: each count is added, not replaced": {
      "file": "src/llm.js",
      "live": "if (Number.isSafeInteger(count) && count > 0) sum[key] += count;",
      "dead": "if (Number.isSafeInteger(count) && count > 0) sum[key] = count;",
      "expect": [
        "tokens are summed per backend; an answer without usage counts as a call only"
      ]
    },
    "Tokens: every answer is a call, usage or not": {
      "file": "src/llm.js",
      "live": "sum.calls += 1;",
      "dead": "sum.calls = 1;",
      "expect": [
        "tokens are summed per backend; an answer without usage counts as a call only"
      ]
    },
    "Tokens: a counted call reports its answer": {
      "file": "src/llm.js",
      "live": "    onAnswer(answer);",
      "dead": "    void onAnswer;",
      "expect": [
        "a counted model call hands each answer on, unchanged, after the model gave it"
      ]
    },
    "Tokens: a job keeps the sum of its answers": {
      "file": "src/server.js",
      "live": "const onAnswer = (answer) => addTokens((job.tokens ??= {}), answer);",
      "dead": "const onAnswer = (answer) => addTokens({}, answer);",
      "expect": [
        "a job's log line sums the tokens of its model answers per backend, failed or not"
      ]
    },
    "Tokens: the log line carries the job's tokens": {
      "file": "src/server.js",
      "live": "        tokens: job.tokens ?? null,",
      "dead": "        tokens: null,",
      "expect": [
        "a job's log line sums the tokens of its model answers per backend, failed or not"
      ]
    },
    "Tokens: serve() counts the real pipeline's answers": {
      "file": "src/serve.js",
      "live": "llm: counted(withModel(llm, model), onAnswer),",
      "dead": "llm: withModel(llm, model),",
      "expect": [
        "serve() writes each job's tokens per backend to the QA log, through the real pipeline"
      ]
    }
  }
}
