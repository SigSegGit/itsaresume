{
  "surface": "deploy",
  "command": [
    "node",
    "--test",
    "--test-reporter=tap"
  ],
  "files": [
    "deploy/vm-generator/compose.yaml",
    "test/deploy.test.js"
  ],
  "defences": {
    "Deploy: the VM router is health-checked on its own port": {
      "file": "deploy/vm-generator/compose.yaml",
      "live": "fetch('http://127.0.0.1:8789/healthz')",
      "dead": "fetch('http://127.0.0.1:8787/healthz')",
      "expect": [
        "the VM router is health-checked on the port it listens on"
      ]
    },
    "Deploy: the VM generator mounts its profile as a folder": {
      "file": "deploy/vm-generator/compose.yaml",
      "live": "      - ${DATA:-~/itsacv-data}/profile:/data/profile:ro",
      "dead": "      - ${DATA:-~/itsacv-data}/profile/profile.json:/data/profile/profile.json:ro",
      "expect": [
        "the VM generator mounts directories only, never a file alone"
      ]
    },
    "Deploy: the VM queue holds a whole comparison": {
      "file": "deploy/vm-generator/compose.yaml",
      "live": "--max-queued 4",
      "dead": "--max-queued 3",
      "expect": [
        "the VM queue holds a whole comparison"
      ]
    }
  }
}
