{
  "command": [
    "node",
    "--test",
    "--test-reporter=tap"
  ],
  "defences": {
    "Importance: the offer's cue decides over the model": {
      "file": "src/normalize.js",
      "live": "const said = importanceIn(offer, String(requirement.name ?? ''));",
      "dead": "const said = null;",
      "expect": [
        "normalize applies the offer's cues over the model's importance, and says so",
        "a never-claimed requirement the offer calls a plus is not counted as a must"
      ]
    },
    "Importance: \"un plus\" only as a verdict": {
      "file": "src/importance.js",
      "live": "'un\\\\s+(?:vrai\\\\s+|gros\\\\s+|réel\\\\s+)?plus(?=\\\\s*(?:[).,;:!]|$))',",
      "dead": "'un\\\\s+plus',",
      "expect": [
        "\"Un plus grand nombre de clusters PostgreSQL.\": PostgreSQL is left to the model"
      ]
    },
    "Importance: \"a plus\" only after is / would be": {
      "file": "src/importance.js",
      "live": "'(?:is|would be|will be|as|considered|a big)\\\\s+a\\\\s+plus',",
      "dead": "'a\\\\s+plus',",
      "expect": [
        "\"Il y a plus de 10 serveurs Linux à administrer.\": Linux is left to the model"
      ]
    },
    "Importance: \"souhaité\" is no cue": {
      "file": "src/importance.js",
      "live": "'souhaitables?',",
      "dead": "'souhaitables?', 'souhaitée?s?',",
      "expect": [
        "\"Profil souhaité : | - PostgreSQL | \": PostgreSQL is left to the model"
      ]
    },
    "Importance: a must anywhere wins": {
      "file": "src/importance.js",
      "live": "return votes.has('must') ? 'must' : votes.has('nice') ? 'nice' : null;",
      "dead": "return votes.has('nice') ? 'nice' : votes.has('must') ? 'must' : null;",
      "expect": [
        "\"Kafka serait un plus. | Compétences requises : Kafka, Linux.\": Kafka is must"
      ]
    },
    "Importance: the predicate closes the enumeration": {
      "file": "src/importance.js",
      "live": "[clause, ...clauses.slice(index + 1), ...clauses.slice(0, index).reverse()]",
      "dead": "[clause, ...clauses.slice(0, index).reverse()]",
      "expect": [
        "\"Une connaissance de Kafka, Terraform et Ansible serait appréciée.\": Kafka is nice"
      ]
    },
    "Importance: an opening cue reaches the clause after it": {
      "file": "src/importance.js",
      "live": ", ...clauses.slice(0, index).reverse()]",
      "dead": "]",
      "expect": [
        "\"Idéalement, une première expérience GCP.\": GCP is nice"
      ]
    },
    "Importance: a header above a list sets its section": {
      "file": "src/importance.js",
      "live": "section = own;",
      "dead": "section = null;",
      "expect": [
        "\"Nice to have: | - Kafka | - Terraform | \": Terraform is nice"
      ]
    },
    "Importance: a header's cue covers the items on its line": {
      "file": "src/importance.js",
      "live": "if (own) lineCue = own;",
      "dead": "void own;",
      "expect": [
        "\"Compétences obligatoires : Ansible, DevOps.\": DevOps is must"
      ]
    }
  }
}
