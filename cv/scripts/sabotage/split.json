{
  "command": [
    "node",
    "--test",
    "--test-reporter=tap"
  ],
  "defences": {
    "Split: a line left out is said": {
      "file": "src/split.js",
      "live": "return { offers, repairs: leftOut(lines, [...checked.ranges.map((item) => item.range), ...(checked.shared ? [checked.shared] : [])]) };",
      "dead": "return { offers, repairs: [] };",
      "expect": [
        "each offer is cut from the lines the model points at, with the shared context first",
        "a requirement line in no range is said, never dropped silently"
      ]
    },
    "Split: blank lines are not reported": {
      "file": "src/split.js",
      "live": "lines.map((line, index) => index + 1).filter((number) => lines[number - 1].trim() && !covered(number));",
      "dead": "lines.map((line, index) => index + 1).filter((number) => !covered(number));",
      "expect": [
        "each offer is cut from the lines the model points at, with the shared context first"
      ]
    }
  }
}
