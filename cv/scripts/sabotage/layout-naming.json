{
  "command": [
    "node",
    "--test",
    "--test-reporter=tap"
  ],
  "defences": {
    "ATS: a blank PDF page is reported": {
      "file": "src/ats.js",
      "live": "if (page.trim() === '') problems.push(",
      "dead": "if (page.trim() === '' && false) problems.push(",
      "expect": [
        "a blank page in the PDF is reported"
      ]
    },
    "Normalise: a requirement named like a skill is met by it": {
      "file": "src/normalize.js",
      "live": "if (named && (requirement.match !== 'yes' || requirement.skills.length !== 1 || requirement.skills[0] !== named)) {",
      "dead": "if (named && false) {",
      "expect": [
        "a requirement named exactly like a profile skill is met by that skill"
      ]
    }
  }
}
