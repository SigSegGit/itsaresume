      "file": "src/split.js",
      "live": "if (shared !== null && !isRange(shared, lines.length)) return",
      "dead": "if (false) return",
      "expect": [
        "ranges out of the text, overlapping, reversed or too short fall back to one offer"
      ]
    },
    "Split: ranges do not overlap": {
      "file": "src/split.js",
      "live": "if (all[i][0] <= all[i - 1][1]) return { reason:",
      "dead": "if (false) return { reason:",
      "expect": [
        "ranges out of the text, overlapping, reversed or too short fall back to one offer"
      ]
    },
    "Split: the shared context comes first": {
      "file": "src/split.js",
      "live": "const context = checked.shared ? [...cut(checked.shared), ''] : [];",
      "dead": "const context = [];",
      "expect": [
        "each offer is cut from the lines the model points at, with the shared context first"
      ]
    },
    "Split: a title is a plain name": {
      "file": "src/split.js",
      "live": "title: cleanName(title ?? '') ?? firstLine(cut(range)),",
      "dead": "title: title || firstLine(cut(range)),",
      "expect": [
