    "Split: the text is fenced": {
      "file": "src/split.js",
      "live": "return fence(numbered).join('\\n');",
      "dead": "return numbered;",
      "expect": [
        "the model is shown numbered lines inside a fence it cannot close"
      ]
    },
    "CLI: --split tailors each offer found": {
      "file": "bin/itsacv.js",
      "live": "offers.push(...found.offers.map((offer) => offer.text));",
      "dead": "offers.push(text);",
      "expect": [
        "itsacv tailor takes several offer files, and --split finds several offers in one"
      ]
    },
    "CLI: the worst exit code wins": {
      "file": "bin/itsacv.js",
      "live": "if (worst) process.exit(worst);",
      "dead": "void worst;",
      "expect": [
        "itsacv tailor writes no CV when the answer stays invalid"
      ]
    },
    "Run: every CV line traces to the truth document": {
      "file": "src/run.js",
      "live": "const quotes = [...checkQuotes(full, texts), ...checkProvenance(full, texts)];",
      "dead": "const quotes = [...checkQuotes(full, texts)];",
      "expect": [
