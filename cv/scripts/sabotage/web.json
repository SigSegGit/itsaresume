{
  "command": [
    "node",
    "--test",
    "--test-reporter=tap"
  ],
  "defences": {
    "Web: only this server's own host name": {
      "file": "src/server.js",
      "live": "if (!hosts.includes(request.headers.host)) throw new HttpError(421,",
      "dead": "if (false) throw new HttpError(421,",
      "expect": [
        "a request naming another host is refused"
      ]
    },
    "Web: a POST comes from this origin": {
      "file": "src/server.js",
      "live": "if (!origins.includes(request.headers.origin)) throw new HttpError(403, ",
      "dead": "if (false) throw new HttpError(403, ",
      "expect": [
        "a POST from another origin, without the token, or not in JSON is refused"
      ]
    },
    "Web: a POST carries the CSRF token": {
      "file": "src/server.js",
      "live": "if (publicMode ? !visitor : !sameToken(request.headers['x-csrf-token'], token)) throw new HttpError(403, ",
      "dead": "if (false) throw new HttpError(403, ",
      "expect": [
        "a POST from another origin, without the token, or not in JSON is refused"
      ]
    },
    "Web: a POST is JSON": {
      "file": "src/server.js",
      "live": "if (!/^application\\/json\\b/.test(request.headers['content-type'] ?? '')) throw new HttpError(415,",
      "dead": "if (false) throw new HttpError(415,",
      "expect": [
        "a POST from another origin, without the token, or not in JSON is refused"
      ]
    },
    "Web: a body is bounded": {
      "file": "src/server.js",
      "live": "request.on('end', () => (size > MAX_BODY ? reject(tooLarge()) : resolve(Buffer.concat(chunks).toString('utf8'))));",
      "dead": "request.on('end', () => resolve(Buffer.concat(chunks).toString('utf8')));",
      "expect": [
        "a POST from another origin, without the token, or not in JSON is refused"
      ]
    },
    "Web: only our own scripts run (CSP)": {
      "file": "src/server.js",
      "live": "'Content-Security-Policy': \"default-src 'none'; script-src 'self';",
      "dead": "'Content-Security-Policy': \"default-src *; script-src *;",
      "expect": [
        "the page carries its CSRF token, and every response forbids framing, sniffing and foreign scripts"
      ]
    },
    "Web: no MIME sniffing": {
      "file": "src/server.js",
      "live": "'X-Content-Type-Options': 'nosniff',",
      "dead": "'X-Content-Type-Options': 'sniff',",
      "expect": [
        "the page carries its CSRF token, and every response forbids framing, sniffing and foreign scripts"
      ]
    },
    "Web: no framing": {
      "file": "src/server.js",
      "live": "'X-Frame-Options': 'DENY',",
      "dead": "'X-Frame-Options': 'SAMEORIGIN',",
      "expect": [
        "the page carries its CSRF token, and every response forbids framing, sniffing and foreign scripts"
      ]
    },
    "Web: the page carries the token": {
      "file": "src/server.js",
      "live": ".replace('__CSRF_TOKEN__', pageToken())",
      "dead": ".replace('__CSRF_TOKEN__', '')",
      "expect": [
        "the page carries its CSRF token, and every response forbids framing, sniffing and foreign scripts"
      ]
    },
    "Web: one run at a time": {
      "file": "src/server.js",
      "live": "if (running) return;",
      "dead": "void running;",
      "expect": [
        "offers are split, then tailored one after the other, with their progress"
      ]
    },
    "Web: a failed run does not stop the queue": {
      "file": "src/server.js",
      "live": "job.status = 'failed';",
      "dead": "throw error;",
      "expect": [
        "a failed run shows its error, and the next one still runs"
      ]
    },
    "Web: only the run's listed files download": {
      "file": "src/server.js",
      "live": "const listed = type && job.result?.view.files.includes(match[2]) && (!publicMode || PUBLIC_FILES.has(match[2]));",
      "dead": "const listed = type && (!publicMode || PUBLIC_FILES.has(match[2]));",
      "expect": [
        "a CV downloads as an attachment, and nothing outside the run's listed files does"
      ]
    },
    "Web: a download is an attachment": {
      "file": "src/server.js",
      "live": "'Content-Disposition': `attachment; filename=",
      "dead": "'Content-Disposition': `inline; filename=",
      "expect": [
        "a CV downloads as an attachment, and nothing outside the run's listed files does"
      ]
    },
    "Web: a split text is bounded": {
      "file": "src/server.js",
      "live": "if (typeof body?.text !== 'string' || !body.text.trim() || body.text.length > MAX_TEXT) {",
      "dead": "if (typeof body?.text !== 'string' || !body.text.trim()) {",
      "expect": [
        "what a job may carry is bounded, and its title is a plain name"
      ]
    },
    "Web: a batch is bounded": {
      "file": "src/server.js",
      "live": "offers.length > MAX_OFFERS",
      "dead": "offers.length > Infinity",
      "expect": [
        "what a job may carry is bounded, and its title is a plain name"
      ]
    },
    "Web: a job title is a plain name": {
      "file": "src/server.js",
      "live": "title: cleanName(offer.title ?? '') ?? 'Offre',",
      "dead": "title: String(offer.title ?? 'Offre'),",
      "expect": [
        "what a job may carry is bounded, and its title is a plain name"
      ]
    },
    "Web: the view lists existing files only": {
      "file": "src/view.js",
      "live": "files: FILES.filter((name) => existsSync(join(dir, name))),",
      "dead": "files: FILES,",
      "expect": [
        "the page's view of a run lists only the files that exist"
      ]
    },
    "Web: the script writes text only": {
      "file": "web/app.js",
      "live": "const POLL_MS = 1500;",
      "dead": "const POLL_MS = 1500; document.body.innerHTML = '';",
      "expect": [
        "the script never parses HTML nor evaluates code"
      ]
    },
    "Web: the page has no inline script": {
      "file": "web/index.html",
      "live": "<script type=\"module\" src=\"/app.js\"></script>",
      "dead": "<script type=\"module\" src=\"/app.js\"></script><script>alert(1)</script>",
      "expect": [
        "the page holds no inline script, style or handler, and loads nothing from elsewhere"
      ]
    },
    "Split: a range stays inside the text": {
      "file": "src/split.js",
      "live": "if (!isRange(range, lines.length)) return { reason:",
      "dead": "if (false) return { reason:",
      "expect": [
        "ranges out of the text, overlapping, reversed or too short fall back to one offer"
      ]
    },
