{
  "command": [
    "node",
    "--test",
    "--test-reporter=tap"
  ],
  "defences": {
    "Pipeline: the retry says what was wrong": {
      "file": "src/pipeline.js",
      "live": "current = retryPrompt(prompt, text, errors);",
      "dead": "current = prompt;",
      "expect": [
        "an invalid answer is sent back once with its errors, and a valid retry is accepted"
      ]
    },
    "Pipeline: one retry": {
      "file": "src/pipeline.js",
      "live": "export const MAX_ATTEMPTS = 2;",
      "dead": "export const MAX_ATTEMPTS = 1;",
      "expect": [
        "an invalid answer is sent back once with its errors, and a valid retry is accepted"
      ]
    },
    "Pipeline: an invalid answer is never accepted": {
      "file": "src/pipeline.js",
      "live": "if (errors.length === 0) return",
      "dead": "if (errors.length >= 0) return",
      "expect": [
        "an answer still invalid after the retry is refused, not rendered",
        "itsacv tailor writes no CV when the answer stays invalid"
      ]
    },
    "Client: JSON content type": {
      "file": "src/llm.js",
      "live": "'Content-Type': 'application/json', 'Content-Length'",
      "dead": "'Content-Type': 'text/plain', 'Content-Length'",
      "expect": [
        "the client posts JSON to /v1/complete and surfaces a router refusal"
      ]
    },
    "Client: a refusal is an error": {
      "file": "src/llm.js",
      "live": "if (response.statusCode < 200 || response.statusCode >= 300) {",
      "dead": "if (false) {",
      "expect": [
        "the client posts JSON to /v1/complete and surfaces a router refusal"
      ]
    },
    "Client: its own timeout, not fetch's": {
      "file": "src/llm.js",
      "live": "}, timeoutMs);",
      "dead": "}, timeoutMs * 10);",
      "expect": [
        "the client waits as long as its own timeout, and no longer"
      ]
    },
    "Client: a backend name is sent only when asked": {
      "file": "src/llm.js",
      "live": "{ prompt, system, ...(backend ? { backend } : {}),",
      "dead": "{ prompt, system,",
      "expect": [
        "the client names a backend only when asked (router 8.22)"
      ]
    },
    "Raw: every call is recorded": {
      "file": "src/pipeline.js",
      "live": "calls.push({ step, backend: answer.backend, text: answer.text });",
      "dead": "void calls;",
      "expect": [
        "itsacv tailor keeps every raw model answer, in call order, in raw.json"
      ]
    },
    "Raw: the analysis calls are labelled": {
      "file": "src/pipeline.js",
      "live": "  step = 'analysis';",
      "dead": "  step = 'listing';",
      "expect": [
        "itsacv tailor keeps every raw model answer, in call order, in raw.json"
      ]
    },
    "Raw: raw.json is written": {
      "file": "src/run.js",
      "live": "writeFileSync(join(dir, 'raw.json'), JSON.stringify({ calls }, null, 2));",
      "dead": "void calls;",
      "expect": [
        "itsacv tailor keeps every raw model answer, in call order, in raw.json"
      ]
    },
    "Client: a schema is sent only when asked": {
      "file": "src/llm.js",
      "live": "...(schema ? { schema } : {}), ...(kind",
      "dead": "...(kind",
      "expect": [
        "the client sends a schema only when asked (router 8.24)"
      ]
    },
    "Client: a call's kind reaches the router": {
      "file": "src/llm.js",
      "live": ", ...(kind ? { kind } : {}) });",
      "dead": " });",
      "expect": [
        "a call marked classify sends its kind; an unmarked call sends none"
      ]
    },
    "Client: a call without a kind sends none": {
      "file": "src/llm.js",
      "live": ", ...(kind ? { kind } : {}) });",
      "dead": ", kind: kind ?? 'generate' });",
      "expect": [
        "a call marked classify sends its kind; an unmarked call sends none"
      ]
    }
  }
}
