{
  "command": [
    "bash",
    "cv/deploy/vm-generator/test-auto-deploy.sh"
  ],
  "defences": {
    "Auto-deploy: main only": {
      "file": "cv/deploy/vm-generator/auto-deploy.sh",
      "live": "if [ \"$branch\" != main ]; then",
      "dead": "if false; then",
      "expect": [
        "another_branch_is_not_deployed"
      ]
    },
    "Auto-deploy: local changes stop it": {
      "file": "cv/deploy/vm-generator/auto-deploy.sh",
      "live": "if [ -n \"$(git status --porcelain --untracked-files=no)\" ]; then",
      "dead": "if false; then",
      "expect": [
        "local_changes_stop_the_deploy"
      ]
    },
    "Auto-deploy: a new commit is deployed": {
      "file": "cv/deploy/vm-generator/auto-deploy.sh",
      "live": "if [ \"$(cat \"$state\" 2>/dev/null)\" = \"$head\" ]; then",
      "dead": "if [ \"$(cat \"$state\" 2>/dev/null)\" = \"$head\" ] || true; then",
      "expect": [
        "a_new_commit_is_pulled_and_deployed",
        "a_failed_build_is_retried"
      ]
    },
    "Auto-deploy: a failed build is not recorded as deployed": {
      "file": "cv/deploy/vm-generator/auto-deploy.sh",
      "live": "docker compose -f \"$compose\" up -d --build\n",
      "dead": "docker compose -f \"$compose\" up -d --build || true\n",
      "expect": [
        "a_failed_build_is_retried"
      ]
    },
    "Auto-deploy: a commit origin lacks is never built": {
      "file": "cv/deploy/vm-generator/auto-deploy.sh",
      "live": "if [ -n \"$(git rev-list origin/main..HEAD)\" ]; then",
      "dead": "if false; then",
      "expect": [
        "an_unpushed_commit_is_not_deployed"
      ]
    },
    "Auto-deploy: a busy generator defers it": {
      "file": "cv/deploy/vm-generator/auto-deploy.sh",
      "live": "if printf '%s' \"$status\" | grep -Eq '\"busy\":[1-9]'; then",
      "dead": "if false; then",
      "expect": [
        "a_busy_generator_defers_the_deploy"
      ]
    }
  }
}
