{
  "surface": "http",
  "command": [
    "cargo",
    "test",
    "-p",
    "itsaresume-router",
    "--no-fail-fast"
  ],
  "files": [
    "crates/itsaresume-router/src/server.rs",
    "crates/itsaresume-router/tests/server.rs"
  ],
  "defences": {
    "Server: stopped is 502": {
      "file": "crates/itsaresume-router/src/server.rs",
      "live": "            502,\n",
      "dead": "            200,\n",
      "expect": [
        "a_stopped_request_is_502_with_the_reason"
      ]
    },
    "Server: oversized is 413": {
      "file": "crates/itsaresume-router/src/server.rs",
      "live": "        413,\n",
      "dead": "        200,\n",
      "expect": [
        "an_oversized_request_is_413"
      ]
    },
    "Server: blank prompt is 400": {
      "file": "crates/itsaresume-router/src/server.rs",
      "live": "if prompt.trim().is_empty() {",
      "dead": "if prompt.trim().is_empty() && false {",
      "expect": [
        "a_malformed_request_is_400"
      ]
    },
    "Server: loopback by default": {
      "file": "crates/itsaresume-router/src/server.rs",
      "live": "pub const DEFAULT_LISTEN: &str = \"127.0.0.1:8787\";",
      "dead": "pub const DEFAULT_LISTEN: &str = \"0.0.0.0:8787\";",
      "expect": [
        "the_default_listen_address_is_loopback"
      ]
    },
    "Server: one thread per request": {
      "file": "crates/itsaresume-router/src/server.rs",
      "live": "std::thread::spawn(move || respond(&router, &running, request));",
      "dead": "respond(&router, &running, request);",
      "expect": [
        "a_slow_completion_does_not_block_other_requests"
      ]
    },
    "Endpoint serves loopback host names only": {
      "file": "crates/itsaresume-router/src/server.rs",
      "live": "if !loopback_host(request) {",
      "dead": "if false && !loopback_host(request) {",
      "expect": [
        "a_foreign_host_is_403_and_loopback_names_are_served"
      ]
    },
    "Endpoint refuses browser origins": {
      "file": "crates/itsaresume-router/src/server.rs",
      "live": "if header(request, \"Origin\").is_some() {",
      "dead": "if false && header(request, \"Origin\").is_some() {",
      "expect": [
        "a_completion_from_a_browser_origin_is_403"
      ]
    },
    "Endpoint takes JSON only": {
      "file": "crates/itsaresume-router/src/server.rs",
      "live": ".is_some_and(|kind| kind.trim().eq_ignore_ascii_case(\"application/json\"))",
      "dead": ".is_some_and(|_| true)",
      "expect": [
        "a_completion_that_is_not_json_is_415"
      ]
    },
    "Endpoint caps concurrent completions": {
      "file": "crates/itsaresume-router/src/server.rs",
      "live": "if current >= MAX_CONCURRENT_COMPLETIONS {",
      "dead": "if current >= usize::MAX {",
      "expect": [
        "completions_beyond_the_cap_are_503_busy"
      ]
    },
    "Endpoint never drains a huge declared body": {
      "file": "crates/itsaresume-router/src/server.rs",
      "live": ".is_some_and(|length| length > MAX_DRAIN_BYTES)",
      "dead": ".is_some_and(|length| length == 0 && length > MAX_DRAIN_BYTES)",
      "expect": [
        "a_huge_declared_body_is_413_and_the_server_lives"
      ]
    },
    "Serve loop returns the error that ends it": {
      "file": "crates/itsaresume-router/src/server.rs",
      "live": "Err(error) => return error,",
      "dead": "Err(error) => drop(error),",
      "expect": [
        "the_serve_loop_returns_the_error_that_ended_it"
      ]
    },
    "Server: the request's backend is read": {
      "file": "crates/itsaresume-router/src/server.rs",
      "live": "Value::String(name) => Some(name.clone()),",
      "dead": "Value::String(_) => None,",
      "expect": [
        "a_request_may_name_its_backend"
      ]
    },
    "Schema: the endpoint passes it on": {
      "file": "crates/itsaresume-router/src/server.rs",
      "live": "Value::Object(_) => Some(value[\"schema\"].clone()),",
      "dead": "Value::Object(_) => None,",
      "expect": [
        "the_schema_reaches_the_backend"
      ]
    },
    "Schema: the endpoint refuses a non-object": {
      "file": "crates/itsaresume-router/src/server.rs",
      "live": "_ => return Err(\"\\\"schema\\\" must be a JSON Schema object\".into()),",
      "dead": "_ => None,",
      "expect": [
        "a_schema_must_be_an_object"
      ]
    },
    "M2: the endpoint reads the kind": {
      "file": "crates/itsaresume-router/src/server.rs",
      "live": "Value::String(kind) if kind == \"classify\" => Kind::Classify,",
      "dead": "Value::String(kind) if kind == \"classify!\" => Kind::Classify,",
      "expect": [
        "a_request_kind_is_generate_or_classify"
      ]
    },
    "Tokens: the HTTP answer reports them": {
      "file": "crates/itsaresume-router/src/server.rs",
      "live": "                body[\"usage\"] = usage.to_json();",
      "dead": "                body[\"usage\"] = Some(usage).filter(|_| false).map(|usage| usage.to_json()).into();",
      "expect": [
        "an_answer_reports_its_tokens"
      ]
    },
    "Contract: every answer is stamped": {
      "file": "crates/itsaresume-router/src/server.rs",
      "live": "    body[\"contract\"] = json!(CONTRACT);",
      "dead": "    let _ = (&mut body, CONTRACT);",
      "expect": [
        "the_contract_answer_has_exactly_the_frozen_keys",
        "the_contract_stamps_every_answer"
      ]
    },
    "Contract: a completion carries no unfrozen key": {
      "file": "crates/itsaresume-router/src/server.rs",
      "live": "json!({\"backend\": answer.backend, \"text\": answer.text, \"attempts\": attempts});",
      "dead": "json!({\"backend\": answer.backend, \"text\": answer.text, \"attempts\": attempts, \"model\": null});",
      "expect": [
        "the_contract_answer_has_exactly_the_frozen_keys"
      ]
    },
    "Contract: an exhausted refusal carries no unfrozen key": {
      "file": "crates/itsaresume-router/src/server.rs",
      "live": "\"message\": \"every backend failed with a quota or an outage\",",
      "dead": "\"message\": \"every backend failed with a quota or an outage\", \"retry\": null,",
      "expect": [
        "the_contract_freezes_the_keys_of_every_refusal"
      ]
    },
    "Contract: a bad request carries no unfrozen key": {
      "file": "crates/itsaresume-router/src/server.rs",
      "live": "(status, json!({\"error\": {\"kind\": kind, \"message\": message}}))",
      "dead": "(status, json!({\"error\": {\"kind\": kind, \"message\": message, \"field\": null}}))",
      "expect": [
        "the_contract_freezes_the_keys_of_every_refusal"
      ]
    }
  }
}
