{
  "surface": "cloud fallbacks (gemini, openai) and checks",
  "command": [
    "cargo",
    "test",
    "-p",
    "itsaresume-router",
    "--test",
    "gemini_cli",
    "--test",
    "config",
    "--test",
    "openai",
    "--test",
    "router",
    "--no-fail-fast"
  ],
  "files": [
    "crates/itsaresume-router/src/backend.rs",
    "crates/itsaresume-router/src/bin/itsaresume-fake-claude.rs",
    "crates/itsaresume-router/src/claude_code.rs",
    "crates/itsaresume-router/src/config.rs",
    "crates/itsaresume-router/src/gemini_cli.rs",
    "crates/itsaresume-router/src/journal.rs",
    "crates/itsaresume-router/src/lib.rs",
    "crates/itsaresume-router/src/lm_studio.rs",
    "crates/itsaresume-router/src/main.rs",
    "crates/itsaresume-router/src/openai.rs",
    "crates/itsaresume-router/src/router.rs",
    "crates/itsaresume-router/src/server.rs",
    "crates/itsaresume-router/src/stats.rs",
    "crates/itsaresume-router/tests/config.rs",
    "crates/itsaresume-router/tests/gemini_cli.rs",
    "crates/itsaresume-router/tests/openai.rs",
    "crates/itsaresume-router/tests/router.rs"
  ],
  "defences": {
    "Gemini accepts only a Google account login": {
      "file": "crates/itsaresume-router/src/gemini_cli.rs",
      "live": "        Some(ACCOUNT_LOGIN) => Ok(()),",
      "dead": "        _ => Ok(()),",
      "expect": [
        "only_a_google_account_login_is_accepted",
        "an_api_key_login_never_starts_the_cli"
      ]
    },
    "Gemini checks the login before starting the CLI": {
      "file": "crates/itsaresume-router/src/gemini_cli.rs",
      "live": "        auth_guard(settings.as_deref())?;",
      "dead": "        let _ = settings;",
      "expect": [
        "an_api_key_login_never_starts_the_cli"
      ]
    },
    "Gemini API key is a metered variable": {
      "file": "crates/itsaresume-router/src/gemini_cli.rs",
      "live": "    \"GEMINI_API_KEY\",",
      "dead": "",
      "expect": [
        "api_keys_and_vertex_switches_are_scrubbed"
      ]
    },
    "Gemini quota falls back": {
      "file": "crates/itsaresume-router/src/gemini_cli.rs",
      "live": "            BackendError::QuotaExceeded(format!(\"gemini: {detail}\"))",
      "dead": "            BackendError::Other(format!(\"gemini: {detail}\"))",
      "expect": [
        "a_quota_error_falls_back"
      ]
    },
    "Gemini schema answer must be JSON": {
      "file": "crates/itsaresume-router/src/gemini_cli.rs",
      "live": "        extract_json(answer).map(|v| v.to_string()).ok_or_else(|| {",
      "dead": "        Some(answer.to_owned()).ok_or_else(|| {",
      "expect": [
        "a_schema_answer_must_be_json_even_inside_a_fence"
      ]
    },
    "Gemini account login scrubs the key": {
      "file": "crates/itsaresume-router/src/gemini_cli.rs",
      "live": "        && !(login == Login::FreeTierKey && name.eq_ignore_ascii_case(\"GEMINI_API_KEY\"))",
      "dead": "        && !name.eq_ignore_ascii_case(\"GEMINI_API_KEY\")",
      "expect": [
        "a_free_tier_key_passes_only_the_key"
      ]
    },
    "Gemini free-tier needs a key": {
      "file": "crates/itsaresume-router/src/gemini_cli.rs",
      "live": "                if !env.iter().any(|(n, v)| {",
      "dead": "                if false && !env.iter().any(|(n, v)| {",
      "expect": [
        "a_free_tier_login_without_a_key_never_starts_the_cli"
      ]
    },
    "Gemini empty response is an error": {
      "file": "crates/itsaresume-router/src/gemini_cli.rs",
      "live": "        Some(v) if v[\"response\"].as_str().is_none_or(|r| r.trim().is_empty()) => {",
      "dead": "        Some(v) if false && v[\"response\"].as_str().is_none_or(|r| r.trim().is_empty()) => {",
      "expect": [
        "an_empty_response_is_an_error_read_from_the_report"
      ]
    },
    "OpenAI never sends without a key": {
      "file": "crates/itsaresume-router/src/openai.rs",
      "live": "        if self.inner.bearer.is_none() {",
      "dead": "        if false {",
      "expect": [
        "no_key_is_other_and_sends_nothing"
      ]
    },
    "OpenAI key goes as a bearer": {
      "file": "crates/itsaresume-router/src/lm_studio.rs",
      "live": "            post = post.header(\"Authorization\", &format!(\"Bearer {bearer}\"));",
      "dead": "            let _ = bearer;",
      "expect": [
        "the_key_goes_as_a_bearer_and_never_in_the_body"
      ]
    },
    "OpenAI schema through the shared rule": {
      "file": "crates/itsaresume-router/src/openai.rs",
      "live": "        inner.schema_as_rule = true;",
      "dead": "        inner.schema_as_rule = false;",
      "expect": [
        "a_schema_uses_the_shared_rule_and_json_object_mode"
      ]
    },
    "Check skips a backend seen within the period": {
      "file": "crates/itsaresume-router/src/router.rs",
      "live": "            if backend.probe().is_some() || recent.iter().any(|r| r == name) {",
      "dead": "            if backend.probe().is_some() {",
      "expect": [
        "a_backend_seen_within_the_period_is_not_checked_again"
      ]
    }
  }
}
