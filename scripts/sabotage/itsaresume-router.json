{
  "command": [
    "cargo",
    "test",
    "-p",
    "itsaresume-router",
    "--no-fail-fast"
  ],
  "defences": {
    "Other never allows fallback": {
      "file": "crates/itsaresume-router/src/backend.rs",
      "live": "Self::Other(_) => false,",
      "dead": "Self::Other(_) => true,",
      "expect": [
        "only_quota_and_unreachable_allow_fallback"
      ]
    },
    "Router stops on Other": {
      "file": "crates/itsaresume-router/src/router.rs",
      "live": "let stop = !error.allows_fallback();",
      "dead": "let stop = false;",
      "expect": [
        "other_error_stops_without_trying_the_next_backend"
      ]
    },
    "Router falls back on quota and outage": {
      "file": "crates/itsaresume-router/src/router.rs",
      "live": "let stop = !error.allows_fallback();",
      "dead": "let stop = true;",
      "expect": [
        "quota_exceeded_falls_back_to_the_next_backend",
        "unreachable_falls_back_to_the_next_backend",
        "every_backend_failing_with_fallback_kinds_is_exhausted_with_attempts_in_order"
      ]
    },
    "Router refuses an empty backend list": {
      "file": "crates/itsaresume-router/src/router.rs",
      "live": "if backends.is_empty() {",
      "dead": "if false {",
      "expect": [
        "an_empty_router_is_refused"
      ]
    },
    "Journal keeps the prompt out": {
      "file": "crates/itsaresume-router/src/journal.rs",
      "live": "\"prompt_chars\": request.prompt.chars().count(),",
      "dead": "\"prompt_chars\": request.prompt.chars().count(), \"prompt\": request.prompt,",
      "expect": [
        "the_prompt_and_answer_text_are_never_written_to_the_journal"
      ]
    },
    "Journal truncates error messages": {
      "file": "crates/itsaresume-router/src/journal.rs",
      "live": "excerpt(attempt.error.message(), MESSAGE_CHARS)",
      "dead": "excerpt(attempt.error.message(), usize::MAX)",
      "expect": [
        "error_messages_are_truncated_in_the_journal"
      ]
    },
    "Router reports a journal it could not write": {
      "file": "crates/itsaresume-router/src/router.rs",
      "live": "if let Err(error) = self.journal.record(request, &outcome, started.elapsed()) {",
      "dead": "if let Err(error) = self.journal.record(request, &outcome, started.elapsed()).or(Ok::<(), std::io::Error>(())) {",
      "expect": [
        "an_unwritable_journal_does_not_lose_the_answer"
      ]
    },
    "Claude: billing tripwire": {
      "file": "crates/itsaresume-router/src/claude_code.rs",
      "live": "if billing != SUBSCRIPTION_BILLING_SOURCE {",
      "dead": "if false {",
      "expect": [
        "the_observed_api_key_run_trips_the_billing_wire",
        "a_successful_answer_billed_to_an_api_key_is_refused"
      ]
    },
    "Claude: tool tripwire": {
      "file": "crates/itsaresume-router/src/claude_code.rs",
      "live": "if !tools_empty {",
      "dead": "if !tools_empty && false {",
      "expect": [
        "a_successful_answer_with_tools_enabled_is_refused"
      ]
    },
    "Claude: init message required": {
      "file": "crates/itsaresume-router/src/claude_code.rs",
      "live": "message[\"type\"] == \"system\" && message[\"subtype\"] == \"init\"",
      "dead": "message[\"type\"] == \"system\" || true",
      "expect": [
        "output_without_an_init_message_is_refused"
      ]
    },
    "Claude: is_error decides, not subtype": {
      "file": "crates/itsaresume-router/src/claude_code.rs",
      "live": "(Some(false), Some(text)) => Ok(Completion {",
      "dead": "(Some(_), Some(text)) => Ok(Completion {",
      "expect": [
        "the_observed_not_logged_in_output_is_other"
      ]
    },
    "Claude: HTTP 429 is quota": {
      "file": "crates/itsaresume-router/src/claude_code.rs",
      "live": "Some(429) => BackendError::QuotaExceeded(detail),",
      "dead": "Some(4290) => BackendError::QuotaExceeded(detail),",
      "expect": [
        "status_429_is_quota_exceeded_whatever_the_message",
        "the_synthetic_usage_limit_is_quota_exceeded"
      ]
    },
    "Claude: 5xx and 529 are unreachable": {
      "file": "crates/itsaresume-router/src/claude_code.rs",
      "live": "Some(500..=504 | 529) => BackendError::Unreachable(detail),",
      "dead": "Some(0) => BackendError::Unreachable(detail),",
      "expect": [
        "server_side_failures_are_unreachable"
      ]
    },
    "Claude: other statuses stop": {
      "file": "crates/itsaresume-router/src/claude_code.rs",
      "live": "Some(_) => BackendError::Other(detail),",
      "dead": "Some(_) => BackendError::Unreachable(detail),",
      "expect": [
        "unrecognised_errors_are_other"
      ]
    },
    "Claude: unknown wording stops": {
      "file": "crates/itsaresume-router/src/claude_code.rs",
      "live": "None => BackendError::Other(detail),",
      "dead": "None => BackendError::Unreachable(detail),",
      "expect": [
        "unrecognised_errors_are_other",
        "the_observed_not_logged_in_output_is_other"
      ]
    },
    "Claude: wording 'usage limit'": {
      "file": "crates/itsaresume-router/src/claude_code.rs",
      "live": "message.contains(\"usage limit\")",
      "dead": "message.contains(\"usage limit-never\")",
      "expect": [
        "usage_limit_wordings_without_a_status_are_quota_exceeded"
      ]
    },
    "Claude: wording 'limit reached'": {
      "file": "crates/itsaresume-router/src/claude_code.rs",
      "live": "|| message.contains(\"limit reached\")",
      "dead": "|| message.contains(\"limit reached-never\")",
      "expect": [
        "usage_limit_wordings_without_a_status_are_quota_exceeded"
      ]
    },
    "Claude: wording 'hit your ... limit'": {
      "file": "crates/itsaresume-router/src/claude_code.rs",
      "live": "(message.contains(\"hit your\") && message.contains(\"limit\"))",
      "dead": "(message.contains(\"hit your-never\") && message.contains(\"limit\"))",
      "expect": [
        "usage_limit_wordings_without_a_status_are_quota_exceeded"
      ]
    },
    "Claude: context errors are not quota": {
      "file": "crates/itsaresume-router/src/claude_code.rs",
      "live": "if message.contains(\"context\") || message.contains(\"too long\") {",
      "dead": "if false {",
      "expect": [
        "context_and_login_errors_are_not_mistaken_for_quota"
      ]
    },
    "Claude: connection wordings are unreachable": {
      "file": "crates/itsaresume-router/src/claude_code.rs",
      "live": ".any(|needle| message.contains(needle))",
      "dead": ".any(|needle| message.contains(needle) && false)",
      "expect": [
        "connection_errors_without_a_status_are_unreachable"
      ]
    },
    "Claude process: metered env removed": {
      "file": "crates/itsaresume-router/src/claude_code.rs",
      "live": ".envs(env.into_iter().filter(|(name, _)| !is_metered(name)))",
      "dead": ".envs(env.into_iter().filter(|(name, _)| !is_metered(name) || true))",
      "expect": [
        "metered_credentials_never_reach_the_child"
      ]
    },
    "Claude process: missing binary is unreachable": {
      "file": "crates/itsaresume-router/src/claude_code.rs",
      "live": "Err(error) if error.kind() == ErrorKind::NotFound => {",
      "dead": "Err(error) if error.kind() == ErrorKind::Interrupted => {",
      "expect": [
        "a_missing_binary_is_unreachable"
      ]
    },
    "Claude process: timeout kills": {
      "file": "crates/itsaresume-router/src/claude_code.rs",
      "live": ".wait_timeout(self.timeout)",
      "dead": ".wait_timeout(self.timeout * 100)",
      "expect": [
        "a_cli_that_does_not_answer_in_time_is_killed_and_unreachable"
      ]
    },
    "Claude process: tools disabled": {
      "file": "crates/itsaresume-router/src/claude_code.rs",
      "live": "            String::new(),\n",
      "dead": "            \"default\".into(),\n",
      "expect": [
        "the_cli_runs_with_json_output_and_no_tools"
      ]
    },
    "Claude process: prompt on stdin": {
      "file": "crates/itsaresume-router/src/claude_code.rs",
      "live": "let _ = stdin.write_all(prompt.as_bytes());",
      "dead": "let _ = stdin.write_all(&prompt.as_bytes()[..0]);",
      "expect": [
        "the_prompt_goes_on_stdin_and_the_answer_comes_back"
      ]
    },
    "Claude process: dedicated workdir": {
      "file": "crates/itsaresume-router/src/claude_code.rs",
      "live": ".current_dir(&self.workdir)",
      "dead": ".current_dir(std::env::temp_dir())",
      "expect": [
        "the_child_runs_in_the_dedicated_working_directory"
      ]
    },
    "Claude process: stderr reported": {
      "file": "crates/itsaresume-router/src/claude_code.rs",
      "live": "excerpt(stderr.trim(), 160)",
      "dead": "excerpt(stderr.trim(), 0)",
      "expect": [
        "a_cli_that_prints_nothing_reports_its_stderr"
      ]
    },
    "LM Studio: no credential header": {
      "file": "crates/itsaresume-router/src/lm_studio.rs",
      "live": ".header(\"Content-Type\", \"application/json\")",
      "dead": ".header(\"Content-Type\", \"application/json\").header(\"Authorization\", \"Bearer sabotage\")",
      "expect": [
        "the_request_is_a_chat_completion_without_any_credential"
      ]
    },
    "LM Studio: no model loaded is unreachable": {
      "file": "crates/itsaresume-router/src/lm_studio.rs",
      "live": "if status == 400 && message.contains(\"No models loaded\") {",
      "dead": "if status == 400 && message.contains(\"No models loaded-never\") {",
      "expect": [
        "the_observed_no_models_loaded_is_unreachable"
      ]
    },
    "LM Studio: 429 is quota": {
      "file": "crates/itsaresume-router/src/lm_studio.rs",
      "live": "429 => BackendError::QuotaExceeded(detail),",
      "dead": "4290 => BackendError::QuotaExceeded(detail),",
      "expect": [
        "status_429_is_quota_exceeded"
      ]
    },
    "LM Studio: gateway statuses are unreachable": {
      "file": "crates/itsaresume-router/src/lm_studio.rs",
      "live": "502..=504 => BackendError::Unreachable(detail),",
      "dead": "5020..=5040 => BackendError::Unreachable(detail),",
      "expect": [
        "gateway_statuses_are_unreachable"
      ]
    },
    "LM Studio: other statuses stop": {
      "file": "crates/itsaresume-router/src/lm_studio.rs",
      "live": "        502..=504 => BackendError::Unreachable(detail),\n        _ => BackendError::Other(detail),",
      "dead": "        502..=504 => BackendError::Unreachable(detail),\n        _ => BackendError::Unreachable(detail),",
      "expect": [
        "other_error_statuses_stop_with_the_servers_message"
      ]
    },
    "LM Studio: transport failures are unreachable": {
      "file": "crates/itsaresume-router/src/lm_studio.rs",
      "live": "| ureq::Error::Io(_) => BackendError::Unreachable(detail),",
      "dead": "| ureq::Error::Io(_) => BackendError::Other(detail),",
      "expect": [
        "a_refused_connection_is_unreachable",
        "a_server_that_does_not_answer_in_time_is_unreachable"
      ]
    },
    "LM Studio: timeout honoured": {
      "file": "crates/itsaresume-router/src/lm_studio.rs",
      "live": ".timeout_global(Some(self.timeout))",
      "dead": ".timeout_global(Some(self.timeout * 100))",
      "expect": [
        "a_server_that_does_not_answer_in_time_is_unreachable"
      ]
    }
  }
}
