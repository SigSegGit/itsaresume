        "lm_studio_takes_one_completion_at_a_time_by_default",
        "a_configured_lm_studio_backend_keeps_one_slot"
      ]
    },
    "Config: max_concurrent = 0 is refused": {
      "file": "crates/itsaresume-router/src/config.rs",
      "live": "b.max_concurrent() == Some(0)",
      "dead": "b.max_concurrent() == Some(usize::MAX)",
      "expect": [
        "max_concurrent_zero_or_on_claude_code_is_refused"
      ]
    },
    "Config: the slot limit reaches the backend": {
      "file": "crates/itsaresume-router/src/config.rs",
      "live": ".with_max_concurrent(self.max_concurrent().unwrap_or(1)),",
      "dead": ".with_max_concurrent(8),",
      "expect": [
        "a_configured_lm_studio_backend_keeps_one_slot"
      ]
    }
  }
}
