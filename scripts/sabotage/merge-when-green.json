{
  "command": [
    "bash",
    "scripts/test-merge-when-green.sh"
  ],
  "defences": {
    "Merge: pinned to the counted head": {
      "file": "scripts/merge-when-green.sh",
      "live": "gh pr merge \"$PR\" --merge --delete-branch --match-head-commit \"$head\"",
      "dead": "gh pr merge \"$PR\" --merge --delete-branch",
      "expect": [
        "a_green_pr_is_merged_pinned_to_its_head",
        "the_head_is_read_before_the_checks"
      ]
    },
    "Merge: every check must pass": {
      "file": "scripts/merge-when-green.sh",
      "live": "if [ \"$passing\" -ne \"$total\" ]; then",
      "dead": "if false; then",
      "expect": [
        "a_pending_check_stops_the_merge"
      ]
    },
    "Merge: the suite's minimum of checks": {
      "file": "scripts/merge-when-green.sh",
      "live": "if [ \"$total\" -lt \"$MINIMUM\" ]; then",
      "dead": "if false; then",
      "expect": [
        "too_few_checks_stop_the_merge"
      ]
    },
    "Merge: a skip counts only once changes passed": {
      "file": "scripts/merge-when-green.sh",
      "live": "if printf '%s\\n' \"$checks\" | grep -q $'^changes\\tpass\\t'; then",
      "dead": "if true; then",
      "expect": [
        "a_skip_without_the_changes_job_stops_the_merge"
      ]
    },
    "Merge: a decided skip is no failure": {
      "file": "scripts/merge-when-green.sh",
      "live": "passing=$((passing + $(printf '%s\\n' \"$checks\" | grep -c $'\\tskipping\\t')))",
      "dead": "passing=$passing",
      "expect": [
        "a_job_skipped_by_the_changes_job_is_no_failure"
      ]
    }
  }
}
